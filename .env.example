NEXT_PUBLIC_SITE_URL=https://ai-book-studio.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# 正式金流背景非同步 Webhook 核銷訂單專用（請勿加上 NEXT_PUBLIC_ 前綴）
SUPABASE_SECRET_KEY=

# 台灣金流：藍新 NewebPay MPG v2.0（填入正式金鑰並將後台切換為 newebpay 即正式啟用）
NEWEBPAY_ENV=production
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# 台灣金流：綠界 ECPay 全方位金流（填入正式金鑰並將後台切換為 ecpay 即正式啟用）
ECPAY_ENV=production
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
